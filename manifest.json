{
  "manifest_version": 3,
  "name": "IMDb Video Player",
  "version": "1.9.9",
  "description": "IMDb video player with multiple embed sources, a Servers list, HDFilmCehennemi popup fallback and an IMDb archive page.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://api.tvmaze.com/*",
    "https://api.themoviedb.org/*",
    "https://www.hdfilmcehennemi.nl/*",
    "https://v3.sg.media-imdb.com/*",
    "https://www.imdb.com/*",
    "https://codeload.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://vidsrc.mov/embed/*"],
      "js": ["vidsrc-mov-relay.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.imdb.com/*title/tt*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    },
    {
      "matches": [
        "*://*.imdb.com/*"
      ],
      "js": [
        "update-banner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "IMDb Arşivi",
    "default_icon": {
      "128": "icon.png"
    }
  }
}
