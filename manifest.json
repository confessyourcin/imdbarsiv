{
  "manifest_version": 3,
  "name": "IMDb Video Player",
  "version": "1.9.1",
  "description": "IMDb video player with VidSrc, VAPlayer, IMDb Player, VidSrc.mov and an HDFilmCehennemi popup fallback, an archive page with IMDb top 10 and search, and in-browser updates from GitHub.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.hdfilmcehennemi.nl/*",
    "https://v3.sg.media-imdb.com/*",
    "https://www.imdb.com/*",
    "https://codeload.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.imdb.com/*title/tt*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    },
    {
      "matches": [
        "*://*.imdb.com/*"
      ],
      "js": [
        "update-banner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "IMDb Arşivi",
    "default_icon": {
      "128": "icon.png"
    }
  }
}